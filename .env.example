# EFMS local configuration. setup_env.py creates a private .env with a fresh SECRET_KEY.
SECRET_KEY=
DEBUG=false
APP_BASE_URL=http://127.0.0.1:5000
PORT=5000


# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/auth/google/callback

# Razorpay TEST keys (optional; leave blank for demo checkout)
RAZORPAY_KEY_ID=rzp_test_Tx2gDIcDDe7lHM
RAZORPAY_KEY_SECRET=yqjEx2mGIKxj7rXHHVvlsfuV


# SMTP email verification (optional; Gmail users should use a Google App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_TIMEOUT=20

# Session settings
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=false
SESSION_LIFETIME_HOURS=12
